{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/tests/**/*",
    "reference/**/*"
  ],
  "exclude": [
    "src/tests/event-handlers-queue-ui.test.ts",
    "src/tests/context-menu-position.test.ts",
    "src/tests/list-keyboard.test.ts",
    "src/tests/image-editor-shortcuts.test.ts",
    "src/tests/filerobot-patches.test.ts"
  ]
}
